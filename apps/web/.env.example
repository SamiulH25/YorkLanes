# Copy to apps/web/.env.local — get values from the database maintainer.
# Setup guide: docs/tasks/auth.md

# Dev (npm run start:dev): use the web origin so /api is proxied and auth cookies work.
PUBLIC_API_URL=http://localhost:4321

# SSR + production proxy: Astro server and middleware forward /api to this URL.
# Render: set to the yorklanes-api service URL (https://yorklanes-api.onrender.com).
# API_INTERNAL_URL=http://localhost:3001

# Prod local (npm run start:prod): no proxy unless API_INTERNAL_URL is set — point at API directly.
# PUBLIC_API_URL=http://localhost:3001
