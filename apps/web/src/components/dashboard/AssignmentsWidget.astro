---
import {
  formatDashboardDueLabel,
  isAssignmentDueUrgent,
} from "../../lib/assignment-dates";
import type { DashboardSummary } from "../../types/dashboard";

interface Props {
  assignments: DashboardSummary["assignments"];
}

const { assignments } = Astro.props;
const hasUpcoming = assignments.upcoming.length > 0;
---

<section class="dashboard-widget surface p-6">
  <div class="widget-header">
    <div>
      <p class="label">Next 7 days</p>
      <h2 class="heading-widget mt-1">Deadlines</h2>
    </div>
    <div class="flex items-center gap-2">
      <a href="/assignments" class="btn-ghost px-3 py-2 text-xs sm:text-sm">
        View all
      </a>
      <div class="icon-badge bg-york-red/10 text-york-red">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
      </div>
    </div>
  </div>

  {
    hasUpcoming ? (
      <ul class="mt-5 space-y-2">
        {assignments.upcoming.map((item) => (
          <li>
            <a
              href="/assignments"
              class="dashboard-list-item flex gap-3 rounded-xl surface-muted px-4 py-3 transition-colors hover:bg-york-red/[0.04]"
            >
              <div
                class:list={[
                  "mt-1 h-full w-1 shrink-0 rounded-full",
                  isAssignmentDueUrgent(item.dueAt) ? "bg-york-red" : "bg-york-gold",
                ]}
                aria-hidden="true"
              />
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-york-black dark:text-white">{item.title}</p>
                {item.courseCode && <p class="text-xs text-york-muted">{item.courseCode}</p>}
              </div>
              <time
                class:list={[
                  "shrink-0 text-xs font-semibold",
                  isAssignmentDueUrgent(item.dueAt) ? "text-york-red" : "text-york-gold",
                ]}
                datetime={item.dueAt}
              >
                {formatDashboardDueLabel(item.dueAt)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="dashboard-empty mt-6">
        <div class="dashboard-empty__icon" aria-hidden="true">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <p class="dashboard-empty__text">
          {assignments.message ?? "No assignments due in the next 7 days."}
        </p>
        <a href="/assignments" class="btn-york mt-4 inline-flex text-sm">Add assignment</a>
      </div>
    )
  }
</section>
