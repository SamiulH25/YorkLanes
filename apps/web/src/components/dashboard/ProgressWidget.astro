---
import type { DashboardSummary } from "../../types/dashboard";

interface Props {
  progress: DashboardSummary["progress"];
}

const { progress } = Astro.props;
// bigger ring so it fills the tall dashboard box better
const radius = 64;
const circumference = 2 * Math.PI * radius;
const segments = progress.segments || [];
const hasPlan = Boolean(progress.planId);
const planHref = progress.planId ? `/plan?id=${progress.planId}` : "/plan";

// colors for each type on the ring
const strokeById: Record<string, string> = {
  major: "stroke-york-red",
  generalEducation: "stroke-york-gold",
  electives: "stroke-stone-400 dark:stroke-stone-500",
};

type RingSegment = {
  id: string;
  label: string;
  strokeClass: string;
  dasharray: string;
  dashoffset: number;
};

// build the colored arcs
let cursor = 0;
const ringSegments: RingSegment[] = [];
for (let i = 0; i < segments.length; i++) {
  const segment = segments[i];
  if (segment.percentOfTotal <= 0) {
    continue;
  }
  const length = (segment.percentOfTotal / 100) * circumference;
  let strokeClass = strokeById.electives;
  if (strokeById[segment.id]) {
    strokeClass = strokeById[segment.id];
  }
  ringSegments.push({
    id: segment.id,
    label: segment.label,
    strokeClass: strokeClass,
    dasharray: length + " " + circumference,
    dashoffset: -cursor * circumference,
  });
  cursor = cursor + segment.percentOfTotal / 100;
}

// if we only got a percent and no segments, just do a red arc
if (ringSegments.length === 0 && progress.percentComplete > 0) {
  const length = (progress.percentComplete / 100) * circumference;
  ringSegments.push({
    id: "major",
    label: "Progress",
    strokeClass: strokeById.major,
    dasharray: length + " " + circumference,
    dashoffset: 0,
  });
}
---

<section
  class="dashboard-widget dashboard-widget--progress surface relative flex h-full flex-col overflow-hidden p-6"
  data-progress-widget
  data-circumference={circumference}
  data-radius={radius}
>
  <div class="widget-header shrink-0">
    <div>
      <p class="label">Degree plan</p>
      <h2 class="heading-widget mt-1">Progress</h2>
    </div>
    <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
      <a href={planHref} class="btn-ghost px-3 py-2 text-xs sm:text-sm" data-progress-plan-link>
        {hasPlan ? "Open plan" : "Get started"}
      </a>
      <a href="/progress" class="badge bg-brand-subtle text-brand" data-plan-aware-nav="progress">
        View details
      </a>
    </div>
  </div>

  <!--
    this body is a size container so the ring can scale off the leftover box height
    (fixed rem sizes were leaving a ton of empty space)
  -->
  <div
    class="mt-4 flex min-h-0 flex-1 flex-col items-center justify-evenly gap-4 px-2 text-center"
    style="container-type: size;"
  >
    <p class="text-secondary max-w-md shrink-0 text-lg leading-snug sm:text-xl" data-progress-label>
      {progress.label}
    </p>

    {
      hasPlan && progress.total !== undefined && progress.total > 0 && (
        <p class="text-xs font-medium text-muted">
          {progress.completed} of {progress.total} courses marked complete
        </p>
      )
    }

    <div
      class="relative shrink-0"
      style="width: min(92cqw, 62cqh); height: min(92cqw, 62cqh); max-width: 100%;"
    >
      <svg class="h-full w-full -rotate-90" viewBox="0 0 140 140" aria-hidden="true" data-progress-ring-svg>
        <circle cx="70" cy="70" r={radius} fill="none" class="chart-track" stroke-width="12"></circle>
        {
          ringSegments.map((segment) => (
            <circle
              data-progress-segment
              data-segment-id={segment.id}
              cx="70"
              cy="70"
              r={radius}
              fill="none"
              class={segment.strokeClass}
              stroke-width="12"
              stroke-dasharray={segment.dasharray}
              stroke-dashoffset={segment.dashoffset}
              stroke-linecap="butt"
            ></circle>
          ))
        }
      </svg>
      <span class="absolute inset-0 flex flex-col items-center justify-center">
        <span class="font-display text-5xl font-bold text-foreground sm:text-6xl" data-progress-percent>
          {progress.percentComplete}%
        </span>
        <span class="text-base font-medium text-muted">complete</span>
      </span>
    </div>

    <div class="shrink-0 space-y-3.5">
      <div class="flex items-center justify-center gap-3 text-base font-medium text-muted sm:text-lg">
        <span class="chart-dot-1 h-3 w-3 rounded-full"></span>
        Major requirements
      </div>
      <div class="flex items-center justify-center gap-3 text-base font-medium text-muted sm:text-lg">
        <span class="chart-dot-2 h-3 w-3 rounded-full"></span>
        General education
      </div>
      <div class="flex items-center justify-center gap-3 text-base font-medium text-muted sm:text-lg">
        <span class="chart-dot-3 h-3 w-3 rounded-full"></span>
        Electives
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // same colors as the server side ring
    var STROKE = {
      major: "stroke-york-red",
      generalEducation: "stroke-york-gold",
      electives: "stroke-stone-400 dark:stroke-stone-500",
    };

    function buildSegments(root, segments, percentComplete) {
      var circumference = Number(root.getAttribute("data-circumference") || "0");
      var radius = Number(root.getAttribute("data-radius") || "64");
      var svg = root.querySelector("[data-progress-ring-svg]");
      if (!svg || circumference <= 0) {
        return;
      }

      // clear old arcs
      var old = svg.querySelectorAll("[data-progress-segment]");
      for (var i = 0; i < old.length; i++) {
        old[i].remove();
      }

      var list = [];
      if (Array.isArray(segments)) {
        list = segments.slice();
      }
      // fallback if api didnt send segments
      if (list.length === 0 && percentComplete > 0) {
        list = [{ id: "major", percentOfTotal: percentComplete }];
      }

      var cursor = 0;
      for (var j = 0; j < list.length; j++) {
        var segment = list[j];
        var pct = Number(segment.percentOfTotal) || 0;
        if (pct <= 0) {
          continue;
        }
        var length = (pct / 100) * circumference;
        var circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        circle.setAttribute("data-progress-segment", "");
        circle.setAttribute("cx", "70");
        circle.setAttribute("cy", "70");
        circle.setAttribute("r", String(radius));
        circle.setAttribute("fill", "none");
        circle.setAttribute("stroke-width", "12");
        circle.setAttribute("stroke-dasharray", length + " " + circumference);
        circle.setAttribute("stroke-dashoffset", String(-cursor * circumference));
        circle.setAttribute("stroke-linecap", "butt");
        circle.setAttribute("class", STROKE[segment.id] || STROKE.electives);
        svg.appendChild(circle);
        cursor = cursor + pct / 100;
      }
    }

    function applyProgress(root, data) {
      var percent = 0;
      if (typeof data.percentComplete === "number") {
        percent = data.percentComplete;
      }

      var label = data.label;
      if (typeof data.message === "string") {
        label = data.message;
      }

      var percentEl = root.querySelector("[data-progress-percent]");
      var labelEl = root.querySelector("[data-progress-label]");

      if (percentEl) {
        percentEl.textContent = percent + "%";
      }
      if (labelEl && label) {
        labelEl.textContent = label;
      }

      var planLink = root.querySelector("[data-progress-plan-link]");
      var planId = data.planId;
      if (!planId) {
        try {
          planId = sessionStorage.getItem("yorklanes-plan-id");
        } catch (e) {}
      }
      if (planLink && planId) {
        planLink.setAttribute("href", "/plan?id=" + encodeURIComponent(planId));
      }

      buildSegments(root, data.segments, percent);
    }

    // sync with whatever plan is saved in sessionStorage
    async function syncFromActivePlan(root) {
      try {
        var planId = sessionStorage.getItem("yorklanes-plan-id");
        if (!planId) {
          return;
        }

        var response = await fetch(
          "/api/progress?planId=" + encodeURIComponent(planId),
          { credentials: "include" },
        );
        if (!response.ok) {
          return;
        }

        var data = await response.json();
        applyProgress(root, data);
      } catch (e) {
        // ignore, keep whatever the server rendered
      }
    }

    function syncAll() {
      var widgets = document.querySelectorAll("[data-progress-widget]");
      for (var i = 0; i < widgets.length; i++) {
        syncFromActivePlan(widgets[i]);
      }
    }

    syncAll();
    document.addEventListener("astro:page-load", syncAll);
  })();
</script>
