---
import type { DashboardSummary } from "../../types/dashboard";
import { componentTypeLabel, seasonLabel } from "../../lib/schedules";

interface Props {
  schedule: DashboardSummary["schedule"];
}

const { schedule } = Astro.props;
const hasClasses = schedule.today.length > 0;
const primary = schedule.primarySchedule;

function formatTime(time: string): string {
  const [hoursRaw, minutes = "00"] = time.split(":");
  const hours = Number(hoursRaw);
  if (!Number.isFinite(hours)) return time;
  const suffix = hours >= 12 ? "PM" : "AM";
  const hour12 = ((hours + 11) % 12) + 1;
  return `${hour12}:${minutes} ${suffix}`;
}

function formatTimeRange(start: string, end: string): string {
  return `${formatTime(start)} – ${formatTime(end)}`;
}

const emptyCta =
  !schedule.hasPrimary && schedule.savedCount > 0
    ? { label: "Use on dashboard", href: "/schedule" }
    : { label: "Open schedule", href: "/schedule" };
---

<section class="dashboard-widget surface p-6">
  <div class="widget-header">
    <div>
      <p class="label">Today</p>
      <h2 class="heading-widget mt-1">Classes</h2>
      {
        primary && (
          <p class="mt-1 text-xs text-muted">
            {seasonLabel(primary.planSeason)} {primary.cdmTerm}
            {schedule.hasPrimary && <span class="dashboard-primary-badge">Dashboard</span>}
          </p>
        )
      }
    </div>
    <div class="flex items-center gap-2">
      <a href="/schedule?view=timetable" class="btn-ghost px-3 py-2 text-xs sm:text-sm">
        Timetable
      </a>
      <div class="icon-badge bg-york-red/10 text-york-red">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
    </div>
  </div>

  {
    hasClasses ? (
      <ul class="mt-5 space-y-2">
        {schedule.today.map((item) => {
          const place = [item.campus, item.room].filter(Boolean).join(" · ");
          return (
            <li>
              <a
                href="/schedule?view=timetable"
                class:list={[
                  "dashboard-list-item flex gap-3 rounded-xl px-4 py-3 transition-colors hover:bg-york-red/[0.04]",
                  item.status === "past" ? "surface-muted opacity-60" : "surface-muted",
                ]}
              >
                <div
                  class:list={[
                    "mt-1 h-full w-1 shrink-0 rounded-full",
                    item.status === "past" ? "bg-york-muted" : "bg-york-red",
                  ]}
                  aria-hidden="true"
                />
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-semibold text-york-black dark:text-white">{item.courseCode}</p>
                  <p class="text-xs text-york-muted">
                    {componentTypeLabel(item.componentType)} · {item.sectionCode}
                    {item.status === "past" && <span> · Ended</span>}
                    {item.status === "in_progress" && <span> · Now</span>}
                  </p>
                  {place && <p class="mt-0.5 text-xs text-muted">{place}</p>}
                </div>
                <time class="shrink-0 text-right text-xs font-semibold text-york-red">
                  {formatTimeRange(item.startTime, item.endTime)}
                </time>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="dashboard-empty mt-6">
        <div class="dashboard-empty__icon" aria-hidden="true">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <p class="dashboard-empty__text">
          {schedule.message ?? "No classes scheduled for today."}
        </p>
        <a href={emptyCta.href} class="btn-york mt-4 inline-flex text-sm">{emptyCta.label}</a>
      </div>
    )
  }
</section>
