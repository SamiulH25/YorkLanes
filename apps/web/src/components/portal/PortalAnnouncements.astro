---
import PortalIcon from "../icons/PortalIcon.astro";
import type { PortalAnnouncementItem } from "../../lib/portal-hub";

interface Props {
  items?: PortalAnnouncementItem[];
}

const { items = [] } = Astro.props;
const announcements = items;
---

<section class="portal-card portal-announcements" aria-label="Announcements">
  <header class="portal-announcements__header">
    <h2 class="portal-card__title portal-announcements__title">Announcements</h2>
  </header>

  {
    announcements.length > 0 ? (
      <ul class="portal-announcements__list" role="list">
        {announcements.map((item) => (
          <li class="portal-announcements__item">
            <span class="portal-announcements__icon" aria-hidden="true">
              <PortalIcon name="megaphone" size={18} />
            </span>
            <div class="portal-announcements__body">
              <div class="portal-announcements__row">
                <h3 class="portal-announcements__item-title">{item.title}</h3>
                <time class="portal-announcements__date">{item.date}</time>
              </div>
              <p class="portal-announcements__text">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="portal-announcements__empty">No announcements right now. Check notifications for assignment and schedule updates.</p>
    )
  }
</section>

<style>
  .portal-announcements__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .portal-announcements.portal-card {
    padding: 1.15rem 1.2rem;
  }

  .portal-announcements__title {
    margin: 0;
  }

  .portal-announcements__empty {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--theme-muted);
  }

  .portal-announcements__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .portal-announcements__item {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: var(--theme-radius, 1rem);
    border: 1px solid var(--theme-border);
    background: var(--theme-surface);
    box-shadow: var(--theme-shadow-card);
  }

  .portal-announcements__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 0.55rem;
    background: color-mix(in srgb, var(--theme-primary) 12%, var(--theme-surface));
    color: var(--theme-primary);
  }

  .portal-announcements__icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .portal-announcements__body {
    min-width: 0;
    flex: 1;
  }

  .portal-announcements__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .portal-announcements__item-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--theme-foreground);
    line-height: 1.3;
  }

  .portal-announcements__date {
    flex-shrink: 0;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--theme-muted);
    white-space: nowrap;
  }

  .portal-announcements__text {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--theme-muted);
  }
</style>
