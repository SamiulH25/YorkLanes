---
/** Assignment calendar — Sarah. Task guide: docs/tasks/assignments.md */
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { fetchAssignments, type Assignment } from "../../lib/assignments";

export const prerender = false;

let loadError: string | null = null;
let assignments: Assignment[] = [];

const cookie = Astro.request.headers.get("cookie");

// --- View / sort / month from query string ---------------------------------
const view = Astro.url.searchParams.get("view") === "calendar" ? "calendar" : "list";
const sort = Astro.url.searchParams.get("sort") === "course" ? "course" : "due";
const monthParam = Astro.url.searchParams.get("month");

try {
  const data = await fetchAssignments(cookie);
  assignments = data.assignments ?? [];
} catch (error) {
  loadError = error instanceof Error ? error.message : "API unavailable";
}

// Starred always float to the top; then the chosen sort key.
const sorted = [...assignments].sort((a, b) => {
  if (a.starred !== b.starred) return a.starred ? -1 : 1;
  if (sort === "course") {
    const byCourse = a.courseCode.localeCompare(b.courseCode);
    if (byCourse !== 0) return byCourse;
  }
  return a.dueAt.localeCompare(b.dueAt);
});

const pendingCount = assignments.filter((item) => !item.done).length;

// --- Calendar grid ----------------------------------------------------------
const pad = (n: number) => String(n).padStart(2, "0");
const today = new Date();
const todayKey = `${today.getFullYear()}-${pad(today.getMonth() + 1)}-${pad(today.getDate())}`;

const monthMatch = /^(\d{4})-(\d{2})$/.exec(monthParam ?? "");
const calYear = monthMatch ? Number(monthMatch[1]) : today.getFullYear();
const calMonth0 = monthMatch ? Number(monthMatch[2]) - 1 : today.getMonth();

const monthStart = new Date(Date.UTC(calYear, calMonth0, 1));
const daysInMonth = new Date(Date.UTC(calYear, calMonth0 + 1, 0)).getUTCDate();
const firstWeekday = monthStart.getUTCDay(); // 0 = Sunday
const monthKey = `${calYear}-${pad(calMonth0 + 1)}`;
const monthLabel = monthStart.toLocaleDateString("en-CA", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const prevDate = new Date(Date.UTC(calYear, calMonth0 - 1, 1));
const nextDate = new Date(Date.UTC(calYear, calMonth0 + 1, 1));
const prevMonth = `${prevDate.getUTCFullYear()}-${pad(prevDate.getUTCMonth() + 1)}`;
const nextMonth = `${nextDate.getUTCFullYear()}-${pad(nextDate.getUTCMonth() + 1)}`;

type Cell = { day: number; key: string } | null;
const cells: Cell[] = [];
for (let i = 0; i < firstWeekday; i += 1) cells.push(null);
for (let d = 1; d <= daysInMonth; d += 1) cells.push({ day: d, key: `${monthKey}-${pad(d)}` });
while (cells.length % 7 !== 0) cells.push(null);

const byDate = new Map<string, Assignment[]>();
for (const a of sorted) {
  const key = a.dueAt.slice(0, 10);
  const bucket = byDate.get(key) ?? [];
  bucket.push(a);
  byDate.set(key, bucket);
}

const weekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

const inputClass =
  "mt-2 w-full rounded-xl border border-york-stone/60 bg-white/80 px-3 py-2.5 text-sm text-york-black outline-none transition focus:border-york-red focus:ring-2 focus:ring-york-red/20 dark:border-white/10 dark:bg-york-graphite dark:text-white";

function formatDueDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-CA", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
}

function dueTone(iso: string, done: boolean): "muted" | "soon" | "overdue" {
  if (done) return "muted";
  const due = new Date(iso);
  const now = new Date();
  const days = Math.ceil((due.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
  if (days < 0) return "overdue";
  if (days <= 7) return "soon";
  return "muted";
}
---

<DashboardLayout title="Assignments | YorkLanes" activeNav="assignments">
  <Fragment slot="header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-york-muted">Deadlines</p>
        <h1 class="heading-page">Assignments</h1>
        <p class="mt-0.5 text-sm text-york-muted">
          {
            pendingCount === 0
              ? "Nothing pending right now."
              : `${pendingCount} pending · ${assignments.length} total`
          }
        </p>
      </div>
      <button type="button" id="show-add-assignment-form-btn" class="btn-york shrink-0">
        Add assignment
      </button>
    </div>
  </Fragment>

  {
    loadError && (
      <div class="mb-5 rounded-xl border border-york-gold/40 bg-york-gold/10 px-4 py-3 text-sm text-stone-700 dark:text-stone-200">
        Could not load assignments: {loadError}. Run{" "}
        <code class="rounded bg-black/5 px-1.5 py-0.5 font-mono text-xs dark:bg-white/10">
          npm run start:dev
        </code>
      </div>
    )
  }

  <div
    id="assignments-flash-banner"
    class="mb-5 hidden rounded-xl border px-4 py-3 text-sm"
    role="status"
  />

  <div id="assignments-root" class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <!-- Left Column: List / Calendar -->
    <section class="surface p-5 sm:p-6">
      <!-- Toolbar: view toggle + sort / month nav -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex rounded-xl surface-muted p-1">
          <a
            href="/assignments?view=list"
            class:list={[
              "rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors",
              view === "list" ? "bg-york-red text-white" : "text-york-muted hover:text-york-black dark:hover:text-white",
            ]}
          >
            List
          </a>
          <a
            href={`/assignments?view=calendar&month=${monthKey}`}
            class:list={[
              "rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors",
              view === "calendar" ? "bg-york-red text-white" : "text-york-muted hover:text-york-black dark:hover:text-white",
            ]}
          >
            Calendar
          </a>
        </div>

        {
          view === "list" ? (
            <div class="flex items-center gap-2 text-xs">
              <span class="text-york-muted">Sort:</span>
              <a
                href="/assignments?view=list&sort=due"
                class:list={[
                  "rounded-lg px-2.5 py-1.5 font-semibold transition-colors",
                  sort === "due" ? "bg-york-red/10 text-york-red" : "text-york-muted hover:text-york-black dark:hover:text-white",
                ]}
              >
                Due date
              </a>
              <a
                href="/assignments?view=list&sort=course"
                class:list={[
                  "rounded-lg px-2.5 py-1.5 font-semibold transition-colors",
                  sort === "course" ? "bg-york-red/10 text-york-red" : "text-york-muted hover:text-york-black dark:hover:text-white",
                ]}
              >
                Course
              </a>
            </div>
          ) : (
            <div class="flex items-center gap-1">
              <a
                href={`/assignments?view=calendar&month=${prevMonth}`}
                class="btn-ghost px-2.5 py-1.5 text-xs"
                aria-label="Previous month"
              >
                ‹
              </a>
              <span class="min-w-[9rem] text-center text-sm font-semibold text-york-black dark:text-white">
                {monthLabel}
              </span>
              <a
                href={`/assignments?view=calendar&month=${nextMonth}`}
                class="btn-ghost px-2.5 py-1.5 text-xs"
                aria-label="Next month"
              >
                ›
              </a>
            </div>
          )
        }
      </div>

      {/* ---------------- LIST VIEW ---------------- */}
      {
        view === "list" &&
          (sorted.length > 0 ? (
            <ul class="mt-5 space-y-2">
              {sorted.map((assignment) => {
                const tone = dueTone(assignment.dueAt, assignment.done);
                return (
                  <li
                    class="assignment-item js-edit-trigger rounded-xl surface-muted px-4 py-3 transition-colors hover:bg-york-red/[0.04] cursor-pointer"
                    data-id={assignment.id}
                    data-title={assignment.title}
                    data-course={assignment.courseCode}
                    data-description={assignment.description || ""}
                    data-due={assignment.dueAt}
                  >
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div class="flex min-w-0 flex-1 gap-3">
                        <div
                          class:list={[
                            "mt-1 h-full w-1 shrink-0 rounded-full",
                            assignment.done
                              ? "bg-stone-400"
                              : tone === "overdue"
                                ? "bg-york-red"
                                : "bg-york-gold",
                          ]}
                          aria-hidden="true"
                        />
                        <div class="min-w-0">
                          <p
                            class:list={[
                              "text-sm font-semibold text-york-black dark:text-white",
                              assignment.done && "text-york-muted line-through",
                            ]}
                          >
                            {assignment.title}
                          </p>
                          {assignment.description && (
                            <p class="mt-0.5 text-xs text-york-muted">{assignment.description}</p>
                          )}
                          <p class="mt-1 text-xs font-medium text-york-muted">{assignment.courseCode}</p>
                        </div>
                      </div>
                      <div class="flex shrink-0 flex-col items-end gap-2">
                        <time
                          class:list={[
                            "text-xs font-semibold",
                            assignment.done && "text-york-muted",
                            !assignment.done && tone === "overdue" && "text-york-red",
                            !assignment.done && tone === "soon" && "text-york-gold",
                            !assignment.done && tone === "muted" && "text-york-muted",
                          ]}
                          datetime={assignment.dueAt}
                        >
                          Due on {formatDueDate(assignment.dueAt)}
                        </time>
                        <div class="flex items-center gap-1.5">
                          {/* Star toggle */}
                          <form class="js-inline-action">
                            <input type="hidden" name="_action" value="toggle-star" />
                            <input type="hidden" name="id" value={assignment.id} />
                            <input type="hidden" name="starred" value={(!assignment.starred).toString()} />
                            <button
                              type="submit"
                              class:list={[
                                "rounded-lg px-2 py-1 text-sm leading-none transition-colors",
                                assignment.starred
                                  ? "text-york-gold"
                                  : "text-york-muted hover:text-york-gold",
                              ]}
                              aria-label={assignment.starred ? "Unstar assignment" : "Star assignment"}
                              title={assignment.starred ? "Unstar" : "Star"}
                            >
                              {assignment.starred ? "★" : "☆"}
                            </button>
                          </form>
                          {/* Done toggle */}
                          <form class="js-inline-action">
                            <input type="hidden" name="_action" value="toggle-done" />
                            <input type="hidden" name="id" value={assignment.id} />
                            <input type="hidden" name="done" value={(!assignment.done).toString()} />
                            <button
                              type="submit"
                              class:list={[
                                "badge transition-colors",
                                assignment.done
                                  ? "bg-emerald-500/15 text-emerald-700 hover:bg-emerald-500/25 dark:text-emerald-300"
                                  : "bg-york-gold/15 text-york-gold hover:bg-york-gold/25",
                              ]}
                              title={assignment.done ? "Mark as not done" : "Mark as done"}
                            >
                              {assignment.done ? "Done" : "Pending"}
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class="empty-state mt-6">
              <p class="text-sm font-medium text-york-black dark:text-white">No assignments yet</p>
              <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">
                Add your first deadline with the button in the header.
              </p>
            </div>
          ))
      }

      {/* ---------------- CALENDAR VIEW ---------------- */}
      {
        view === "calendar" && (
          <div class="mt-5">
            <div class="grid grid-cols-7 gap-1 text-center text-[11px] font-semibold uppercase tracking-wide text-york-muted">
              {weekdayNames.map((name) => (
                <div class="py-1">{name}</div>
              ))}
            </div>
            <div class="mt-1 grid grid-cols-7 gap-1">
              {cells.map((cell) =>
                cell === null ? (
                  <div class="min-h-[5.5rem] rounded-lg bg-transparent" />
                ) : (
                  <div
                    class:list={[
                      "js-day min-h-[5.5rem] cursor-pointer rounded-lg border p-1.5 text-left transition-colors hover:border-york-red/50",
                      cell.key === todayKey
                        ? "border-york-red/60 bg-york-red/5"
                        : "border-york-stone/40 dark:border-white/10",
                    ]}
                    data-date={cell.key}
                  >
                    <div
                      class:list={[
                        "mb-1 text-xs font-semibold",
                        cell.key === todayKey ? "text-york-red" : "text-york-muted",
                      ]}
                    >
                      {cell.day}
                    </div>
                    <div class="space-y-1">
                      {(byDate.get(cell.key) ?? []).slice(0, 3).map((assignment) => (
                        <button
                          type="button"
                          class:list={[
                            "js-edit-trigger block w-full truncate rounded px-1.5 py-1 text-left text-[11px] font-medium transition-colors",
                            assignment.done
                              ? "bg-stone-400/15 text-york-muted line-through"
                              : "bg-york-red/10 text-york-red hover:bg-york-red/20",
                          ]}
                          data-id={assignment.id}
                          data-title={assignment.title}
                          data-course={assignment.courseCode}
                          data-description={assignment.description || ""}
                          data-due={assignment.dueAt}
                          title={`${assignment.title} · ${assignment.courseCode}`}
                        >
                          {assignment.starred ? "★ " : ""}
                          {assignment.title}
                        </button>
                      ))}
                      {(byDate.get(cell.key) ?? []).length > 3 && (
                        <p class="px-1.5 text-[10px] text-york-muted">
                          +{(byDate.get(cell.key) ?? []).length - 3} more
                        </p>
                      )}
                    </div>
                  </div>
                ),
              )}
            </div>
            <p class="mt-3 text-xs text-york-muted">
              Click a day to add an assignment · click an assignment to edit it.
            </p>
          </div>
        )
      }
    </section>

    <!-- Right Column: Forms -->
    <div class="space-y-5">
      <!-- Add Assignment Form -->
      <section class="surface h-fit p-5 sm:p-6">
        <div class="widget-header">
          <div>
            <p class="label">New entry</p>
            <h2 class="heading-widget mt-1">Add assignment</h2>
          </div>
        </div>

        <p
          id="assignments-form-error"
          class="mt-4 hidden rounded-lg border border-york-red/30 bg-york-red/5 px-3 py-2 text-sm text-york-red"
          role="alert"
        />

        <form
          id="add-assignment-form"
          class="mt-5 hidden space-y-4"
        >
          <input type="hidden" name="_action" value="create" />
          <label class="block">
            <span class="label">Title</span>
            <input type="text" name="title" required class={inputClass} placeholder="Essay draft" />
          </label>
          <label class="block">
            <span class="label">Course code</span>
            <input type="text" name="courseCode" required class={inputClass} placeholder="CWR 2600" />
          </label>
          <label class="block">
            <span class="label">Description</span>
            <input type="text" name="description" class={inputClass} placeholder="Optional notes" />
          </label>
          <label class="block">
            <span class="label">Due date</span>
            <input type="date" name="dueDate" id="add-due" required class={inputClass} />
          </label>
          <div class="flex flex-wrap gap-2 pt-1">
            <button type="submit" class="btn-york flex-1 sm:flex-none">Save assignment</button>
            <button type="button" id="hide-add-assignment-form-btn" class="btn-ghost">Cancel</button>
          </div>
        </form>

        <p
          id="add-assignment-form-hint"
          class="mt-5 text-sm text-york-muted"
        >
          Use <span class="font-medium text-york-black dark:text-white">Add assignment</span> in the
          header to open the form.
        </p>
      </section>

      <!-- Edit Assignment Form -->
      <section class="surface h-fit p-5 sm:p-6">
        <div class="widget-header">
          <div>
            <p class="label">Edit existing assignment</p>
            <h2 class="heading-widget mt-1">Edit assignment</h2>
          </div>
          <button
            type="button"
            id="delete-assignment-btn"
            class="btn-ghost text-york-red hover:bg-york-red/10 hidden"
          >
            Delete
          </button>
        </div>

        <p
          id="assignments-edit-success"
          class="mt-4 hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200"
          role="status"
        />

        <p
          id="assignments-edit-error"
          class="mt-4 hidden rounded-lg border border-york-red/30 bg-york-red/5 px-3 py-2 text-sm text-york-red"
          role="alert"
        />

        <form id="edit-assignment-form" class="mt-5 hidden space-y-4">
          <input type="hidden" name="_action" value="update" />
          <input type="hidden" name="id" id="edit-id" />

          <label class="block">
            <span class="label">Title</span>
            <input type="text" name="title" id="edit-title" required class={inputClass} placeholder="Essay draft" />
          </label>
          <label class="block">
            <span class="label">Course code</span>
            <input type="text" name="courseCode" id="edit-course" required class={inputClass} placeholder="CWR 2600" />
          </label>
          <label class="block">
            <span class="label">Description</span>
            <input type="text" name="description" id="edit-description" class={inputClass} placeholder="Optional notes" />
          </label>
          <label class="block">
            <span class="label">Due date</span>
            <input type="date" name="dueDate" id="edit-due" required class={inputClass} />
          </label>
          <div class="flex flex-wrap gap-2 pt-1">
            <button type="submit" class="btn-york flex-1 sm:flex-none">Update assignment</button>
            <button type="button" id="hide-edit-assignment-form-btn" class="btn-ghost">Cancel</button>
          </div>
        </form>

        <p id="edit-assignment-form-hint" class="mt-5 text-sm text-york-muted">
          Click an assignment (in the list or calendar) to open the form.
        </p>
      </section>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div
    id="delete-modal"
    class="fixed inset-0 bg-black/50 flex items-center justify-center hidden z-50"
  >
    <div class="bg-white dark:bg-york-graphite rounded-2xl p-6 max-w-md w-full mx-4">
      <h3 class="text-lg font-semibold text-york-black dark:text-white">Delete Assignment</h3>
      <p class="mt-2 text-sm text-york-muted">Are you sure you want to delete this assignment?</p>
      <div id="delete-assignment-info" class="mt-3 p-3 rounded-lg bg-york-red/5 border border-york-red/20">
        <p class="text-sm font-medium" id="delete-title"></p>
        <p class="text-xs text-york-muted mt-1" id="delete-course"></p>
        <p class="text-xs text-york-muted" id="delete-due"></p>
      </div>
      <div class="flex gap-3 mt-5">
        <form class="flex-1">
          <input type="hidden" name="_action" value="delete" />
          <input type="hidden" name="id" id="delete-id" />
          <button type="submit" class="w-full btn-york bg-york-red hover:bg-york-red/90">Yes, delete</button>
        </form>
        <button type="button" id="cancel-delete-btn" class="flex-1 btn-ghost">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    const { bootAssignmentsPage } = await import("../../scripts/assignments-page.ts");
    bootAssignmentsPage();
  </script>
</DashboardLayout>
