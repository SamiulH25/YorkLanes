---
import PortalLayout from "../../layouts/PortalLayout.astro";
import PortalActionGrid from "../../components/portal/PortalActionGrid.astro";
import PortalWelcomeBanner from "../../components/portal/PortalWelcomeBanner.astro";
import PortalCoursesSection, { type PortalCourse } from "../../components/portal/PortalCoursesSection.astro";
import PortalAnnouncements from "../../components/portal/PortalAnnouncements.astro";
import PortalAdvisorCard from "../../components/portal/PortalAdvisorCard.astro";
import PortalUpcoming from "../../components/portal/PortalUpcoming.astro";
import PortalTasks from "../../components/portal/PortalTasks.astro";
import PortalQuickLinks from "../../components/portal/PortalQuickLinks.astro";
import { fetchDashboardSummary } from "../../lib/api";
import { fetchSessionUser } from "../../lib/auth";
import { fetchOnboardingStatus } from "../../lib/onboarding";
import { emptyHubFallback, guestHubFallback, hubAnnouncementsFromSummary, hubFromSummary } from "../../lib/portal-hub";
import type { DashboardSummary } from "../../types/dashboard";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");

function guestFinanceSummary(message: string): DashboardSummary["finance"] {
  return {
    balance: 0,
    income: 0,
    expenses: 0,
    currency: "CAD",
    month: new Date().toISOString().slice(0, 7),
    monthSpent: 0,
    monthBudget: 0,
    monthRemaining: 0,
    linked: false,
    message,
  };
}

function guestDashboardSummary(financeMessage: string): DashboardSummary {
  return {
    user: { displayName: "Guest", programme: null, startingYear: null },
    progress: { percentComplete: 0, label: "Sign in to sync degree progress", segments: [] },
    assignments: {
      upcoming: [],
      message: "Sign in to sync assignments, or open Assignments to continue.",
    },
    schedule: {
      today: [],
      hasPrimary: false,
      savedCount: 0,
      message: "Sign in and build your schedule to see today's classes.",
    },
    finance: guestFinanceSummary(financeMessage),
    hub: guestHubFallback(),
  };
}

let summary: DashboardSummary;
let loadError: string | null = null;
let showOnboardingBanner = false;

const sessionUser = await fetchSessionUser(cookie);
const isGuest = !sessionUser;

try {
  if (!sessionUser) {
    summary = guestDashboardSummary(
      "Open Finances to track a local draft on this device. Sign in later to sync cloud totals here.",
    );
  } else {
    summary = await fetchDashboardSummary(cookie);
    const onboardingStatus = await fetchOnboardingStatus(cookie);
    showOnboardingBanner = onboardingStatus.signedIn && !onboardingStatus.completed;
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : "Failed to load dashboard";
  summary = guestDashboardSummary(
    "Open Finances to track a local draft, or start the API and sign in to sync.",
  );
  if (sessionUser) {
    summary = {
      ...summary,
      hub: emptyHubFallback(),
      user: {
        displayName: sessionUser.displayName,
        programme: null,
        startingYear: null,
      },
      assignments: {
        upcoming: [],
        message: "Assignment data is unavailable right now.",
      },
      schedule: {
        ...summary.schedule,
        message: "Schedule data is unavailable right now.",
      },
    };
  }
}

const classCount = summary.schedule.today.length;
const deadlineCount = summary.assignments.upcoming.length;
const progressPct = summary.progress.percentComplete;
const coursesTotal = summary.progress.total ?? 0;
const creditsCompleted = summary.progress.completed ?? 0;
const creditsTotal = coursesTotal;

function portalCoursesFromSchedule(
  today: DashboardSummary["schedule"]["today"],
): PortalCourse[] {
  const seen = new Set<string>();
  const result: PortalCourse[] = [];

  for (const item of today) {
    const code = item.courseCode.trim();
    if (!code || seen.has(code)) continue;
    seen.add(code);
    result.push({
      code,
      title: code,
      credits: 3,
      gradePercent: null,
      letterGrade: null,
    });
  }

  return result;
}

const portalCourses = portalCoursesFromSchedule(summary.schedule.today);
const announcementItems = hubAnnouncementsFromSummary(summary);
const portalHub = hubFromSummary(summary);
---

<PortalLayout title="Dashboard | YorkLanes" activeNav="dashboard" hub={portalHub}>
  <Fragment slot="actions">
    <PortalActionGrid activeNav="dashboard" />
  </Fragment>

  {
    loadError && (
      <div class="mb-5 rounded-xl border border-accent-soft bg-accent-soft px-4 py-3 text-sm text-secondary">
        API offline: {loadError}. Run <code class="rounded bg-black/5 px-1.5 py-0.5 font-mono text-xs dark:bg-white/10">npm run start:dev</code>
      </div>
    )
  }

  {
    showOnboardingBanner && (
      <div class="mb-5 surface-elevated flex flex-wrap items-center justify-between gap-4 border border-brand-soft bg-brand-subtle p-5">
        <div>
          <p class="text-sm font-semibold text-foreground">Finish setting up YorkLanes</p>
          <p class="mt-0.5 text-sm text-muted">
            Tell us your programme and import your checklist to build your degree plan.
          </p>
        </div>
        <a href="/onboarding" class="btn-york shrink-0">Continue setup</a>
      </div>
    )
  }

  <div class="portal-dashboard-grid">
    <div class="portal-dashboard-main">
      <PortalWelcomeBanner
        guest={isGuest}
        displayName={summary.user.displayName}
        classCount={classCount}
        assignmentCount={deadlineCount}
        courseAverage={null}
        holdCount={0}
      />

      <PortalCoursesSection
        guest={isGuest}
        courses={portalCourses}
        creditsCompleted={creditsCompleted}
        creditsTotal={creditsTotal}
        percent={progressPct}
        emptyMessage={summary.schedule.message ?? summary.progress.label}
      />

      <div class="portal-dashboard-bottom">
        <PortalAnnouncements items={announcementItems ?? []} />
        <PortalAdvisorCard />
      </div>
    </div>

    <aside class="portal-sidebar" aria-label="Dashboard sidebar">
      <PortalUpcoming schedule={summary.schedule} />
      <PortalTasks assignments={summary.assignments} guest={isGuest} />
      <PortalQuickLinks />
    </aside>
  </div>
</PortalLayout>
