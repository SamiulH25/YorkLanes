---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PortalHubFeed from "../../components/portal/PortalHubFeed.astro";
import { fetchDashboardHub } from "../../lib/api";
import { fetchSessionUser } from "../../lib/auth";
import {
  emptyHubFallback,
  guestHubFallback,
  hubMessagesForPanels,
} from "../../lib/portal-hub";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const sessionUser = await fetchSessionUser(cookie);

let hub = sessionUser ? emptyHubFallback() : guestHubFallback();
if (sessionUser) {
  try {
    hub = (await fetchDashboardHub(cookie)).hub;
  } catch {
    // Fall back to empty hub when the API is unavailable.
  }
}

const messages = hubMessagesForPanels(hub);
---

<DashboardLayout title="Messages | YorkLanes" activeNav="dashboard">
  <Fragment slot="header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-york-muted">Inbox</p>
        <h1 class="heading-page">Messages</h1>
        <p class="mt-0.5 text-sm text-muted">
          Assignment reminders and updates from your YorkLanes workspace.
        </p>
      </div>
      <a href="/assignments" class="btn-york shrink-0 px-4 py-2 text-sm">Go to assignments</a>
    </div>
  </Fragment>

  <section class="surface p-5">
    <PortalHubFeed
      kind="messages"
      messages={messages}
      emptyTitle="No messages yet"
      emptyBody="When you have upcoming assignments, reminders will show up here and in the header dropdown."
    />
  </section>
</DashboardLayout>
