---
import PortalLayout from "../../layouts/PortalLayout.astro";
import PortalActionGrid from "../../components/portal/PortalActionGrid.astro";
import PortalHubFeed from "../../components/portal/PortalHubFeed.astro";
import { fetchDashboardSummary } from "../../lib/api";
import { fetchSessionUser } from "../../lib/auth";
import {
  emptyHubFallback,
  guestHubFallback,
  hubFromSummary,
  hubMessagesForPanels,
} from "../../lib/portal-hub";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const sessionUser = await fetchSessionUser(cookie);

let hub = sessionUser ? emptyHubFallback() : guestHubFallback();
if (sessionUser) {
  try {
    hub = hubFromSummary(await fetchDashboardSummary(cookie));
  } catch {
    // Fall back to empty hub when the API is unavailable.
  }
}

const messages = hubMessagesForPanels(hub);
---

<PortalLayout title="Messages | YorkLanes" hub={hub}>
  <Fragment slot="actions">
    <PortalActionGrid activeNav="dashboard" />
  </Fragment>

  <Fragment slot="breadcrumbs">
    <nav aria-label="Breadcrumb">
      <ol class="portal-breadcrumbs">
        <li class="portal-breadcrumbs__item">
          <a href="/dashboard" class="portal-breadcrumbs__link">Home</a>
        </li>
        <li class="portal-breadcrumbs__item">
          <span class="portal-breadcrumbs__current" aria-current="page">Messages</span>
        </li>
      </ol>
    </nav>
  </Fragment>

  <div class="portal-inbox-page">
    <header class="portal-inbox-page__header">
      <div>
        <p class="portal-inbox-page__eyebrow">Inbox</p>
        <h1 class="portal-inbox-page__title">Messages</h1>
        <p class="portal-inbox-page__subtitle">
          Assignment reminders and updates from your YorkLanes workspace.
        </p>
      </div>
      <a href="/assignments" class="portal-inbox-page__cta">Go to assignments</a>
    </header>

    <PortalHubFeed
      kind="messages"
      messages={messages}
      emptyTitle="No messages yet"
      emptyBody="When you have upcoming assignments, reminders will show up here and in the header dropdown."
    />
  </div>
</PortalLayout>
