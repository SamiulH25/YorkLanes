---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PortalHubFeed from "../../components/portal/PortalHubFeed.astro";
import { fetchDashboardSummary } from "../../lib/api";
import { fetchSessionUser } from "../../lib/auth";
import {
  emptyHubFallback,
  guestHubFallback,
  hubFromSummary,
  hubNotificationsForPanels,
} from "../../lib/portal-hub";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const sessionUser = await fetchSessionUser(cookie);

let hub = sessionUser ? emptyHubFallback() : guestHubFallback();
if (sessionUser) {
  try {
    hub = hubFromSummary(await fetchDashboardSummary(cookie));
  } catch {
    // Fall back to empty hub when the API is unavailable.
  }
}

const notifications = hubNotificationsForPanels(hub);
---

<DashboardLayout title="Notifications | YorkLanes" activeNav="dashboard">
  <Fragment slot="header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-york-muted">Activity</p>
        <h1 class="heading-page">Notifications</h1>
        <p class="mt-0.5 text-sm text-muted">
          Assignment due dates, schedule changes, finance alerts, and setup reminders.
        </p>
      </div>
      <a href="/dashboard" class="btn-ghost shrink-0 px-4 py-2 text-sm">Back to dashboard</a>
    </div>
  </Fragment>

  <section class="surface p-5">
    <PortalHubFeed
      kind="notifications"
      notifications={notifications}
      emptyTitle="You're all caught up"
      emptyBody="New notifications from assignments, your schedule, and finances will appear here."
    />
  </section>
</DashboardLayout>
