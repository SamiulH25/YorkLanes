---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { fetchMyPlan, fetchPlan } from "../../lib/plans";
import {
  formatTermCredits,
  formatYearCredits,
  summarizeChecklistYear,
  summarizeTerm,
} from "../../lib/plan-credits";
import { planExpectsComplementaryStudies } from "../../lib/plan-complementary";
import {
  formatComplementaryStubDisplay,
  formatStubDragLabel,
  isComplementaryStub,
  isComplementaryStubDraggable,
} from "../../lib/complementary-stub";
import type { PlanCourse, PlanTerm } from "../../types/plan";

// Must be server-rendered so ?id= query param and plan data resolve per request.
export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const planIdParam = Astro.url.searchParams.get("id");

let plan = null;
let loadError: string | null = null;

if (planIdParam) {
  try {
    plan = await fetchPlan(planIdParam, cookie);
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Failed to load plan";
  }
} else {
  try {
    plan = await fetchMyPlan(cookie);
    if (plan) {
      return Astro.redirect(`/plan?id=${plan.id}`);
    }
  } catch (error) {
    loadError = error instanceof Error ? error.message : "Failed to load plan";
  }
}

const planId = plan?.id ?? planIdParam ?? "";

type Season = "fall" | "winter" | "summer" | "other";

interface YearColumn {
  checklistYear: number;
  academicYear: number;
  fall: PlanTerm | null;
  winter: PlanTerm | null;
  summer: PlanTerm | null;
}

function normalizeSeason(session: string): Season {
  const value = session.toLowerCase();
  if (value.includes("fall") || value.includes("autumn")) return "fall";
  if (value.includes("winter")) return "winter";
  if (value.includes("summer")) return "summer";
  return "other";
}

function groupTermsByYear(terms: PlanTerm[]): YearColumn[] {
  const byYear = new Map<number, YearColumn>();

  for (const term of terms) {
    const key = term.checklist_year;
    let column = byYear.get(key);
    if (!column) {
      column = {
        checklistYear: key,
        academicYear: term.academic_year,
        fall: null,
        winter: null,
        summer: null,
      };
      byYear.set(key, column);
    }

    const season = normalizeSeason(term.session);
    if (season === "fall") column.fall = term;
    else if (season === "winter") column.winter = term;
    else if (season === "summer") column.summer = term;
    else if (!column.fall) column.fall = term;
    else if (!column.winter) column.winter = term;
    else column.summer = term;
  }

  return [...byYear.values()].sort((a, b) => a.checklistYear - b.checklistYear);
}

function academicSpan(year: number): string {
  return `${year}–${String(year + 1).slice(-2)}`;
}

interface SeasonSlot {
  key: Season;
  term: PlanTerm | null;
  label: string;
}

function seasonSlotsForYear(year: YearColumn, includeSummer: boolean): SeasonSlot[] {
  const seasons: SeasonSlot[] = [
    { key: "fall", term: year.fall, label: "Fall" },
    { key: "winter", term: year.winter, label: "Winter" },
  ];
  if (includeSummer) {
    seasons.push({ key: "summer", term: year.summer, label: "Summer" });
  }
  return seasons;
}

const yearColumns = plan ? groupTermsByYear(plan.terms) : [];
const showSummerRow = yearColumns.length > 0;
const showComplementaryStudies = plan ? planExpectsComplementaryStudies(plan) : false;
---

<DashboardLayout title="Degree Plan | YorkLanes" activeNav="plan" collapseSidebar>
  <Fragment slot="header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-medium text-york-muted">Degree plan editor</p>
        <h1 class="heading-page">{plan?.programme_name ?? "Your degree plan"}</h1>
        {
          plan && (
            <p class="mt-0.5 text-sm text-york-muted">
              Started {plan.starting_year} · {yearColumns.length} year{yearColumns.length === 1 ? "" : "s"} · from {plan.source_filename}
            </p>
          )
        }
      </div>
      <a href="/plan/setup" class="btn-york">Import new checklist</a>
    </div>
  </Fragment>

  {
    !planId && (
      <div class="surface mx-auto max-w-lg rounded-2xl p-8 text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-york-red">Get started</p>
        <h2 class="mt-2 font-display text-xl font-semibold text-york-black dark:text-white">Import your degree checklist</h2>
        <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
          Download the checklist from your faculty site, upload it on the next screen, and we parse your courses into a term plan.
        </p>
        <ol class="mt-6 space-y-2 text-left text-sm text-stone-600 dark:text-stone-300">
          <li><span class="font-semibold text-york-black dark:text-white">1.</span> Choose your faculty and programme details</li>
          <li><span class="font-semibold text-york-black dark:text-white">2.</span> Download the PDF or DOCX checklist</li>
          <li><span class="font-semibold text-york-black dark:text-white">3.</span> Upload the file and we build your plan</li>
        </ol>
        <a href="/plan/setup" class="btn-york mt-6 inline-flex">Go to checklist import</a>
      </div>
    )
  }

  {
    loadError && (
      <div class="mb-6 rounded-xl border border-york-gold/40 bg-york-gold/10 px-4 py-3 text-sm">
        {loadError}. Try importing again from <a href="/plan/setup" class="text-york-red underline">plan setup</a>.
      </div>
    )
  }

  {
    plan && plan.parse_warnings.length > 0 && (
      <div class="plan-alert-panel plan-alert-panel--notes mb-4">
        <p class="plan-alert-panel__title">Parser notes</p>
        <ul class="plan-alert-panel__notes-list">
          {plan.parse_warnings.map((warning) => (
            <li>{warning}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    plan && (
      <script is:inline define:vars={{ planId: plan.id }}>
        try {
          sessionStorage.setItem("yorklanes-plan-id", planId);
          document.dispatchEvent(new Event("yorklanes:plan-id"));
        } catch (_) {}
      </script>
    )
  }

  {
    plan && (
      <div id="plan-editor" data-plan-id={plan.id}>
        <script id="plan-data" type="application/json" is:inline set:html={JSON.stringify(plan)} />

        <div class="plan-editor-toolbar">
          <div class="plan-editor-toolbar__left">
            <p id="plan-dep-summary" class="text-york-muted" />
            {
              showComplementaryStudies && (
                <div class="plan-complementary-toolbar">
                  <div class="plan-complementary-upload">
                    <label
                      id="plan-complementary-dropzone"
                      class="plan-complementary-dropzone"
                      title="Upload complementary studies availability PDF"
                    >
                      <input
                        id="plan-complementary-input"
                        type="file"
                        accept=".pdf,application/pdf"
                        class="sr-only"
                      />
                      <span id="plan-complementary-label">Complementary PDF</span>
                    </label>
                    <p id="plan-complementary-status" class="plan-complementary-status text-xs text-york-muted" />
                  </div>
                  <button type="button" id="plan-find-complementary" class="plan-find-complementary" disabled>
                    Find complementary
                  </button>
                </div>
              )
            }
          </div>
          <div class="text-right">
            <p id="plan-selected-course" class="font-medium text-york-black dark:text-white" />
            <p id="plan-link-legend" class="hidden mt-1 text-xs text-york-muted" />
          </div>
        </div>

        <div id="plan-missing-required" class="plan-alert-panel plan-alert-panel--missing hidden" aria-live="polite" aria-hidden="true">
          <p class="plan-alert-panel__title">Missing required courses</p>
          <p class="plan-alert-panel__hint">
            These checklist courses were removed from your plan. Re-add them with <strong>+ Add course</strong> or drag a replacement into the same term.
          </p>
          <ul id="plan-missing-required-list" class="plan-missing-required__list"></ul>
        </div>

        <div class="plan-alerts">
        {
          showComplementaryStudies && (
            <div id="plan-complementary-warnings" class="plan-alert-panel plan-alert-panel--complementary hidden" aria-live="polite">
              <p class="plan-alert-panel__title">Complementary studies</p>
              <p class="plan-alert-panel__hint">
                Progress toward your uploaded complementary availability PDF and open checklist slots.
              </p>
              <ul id="plan-complementary-warnings-list" class="plan-alert-panel__content"></ul>
            </div>
          )
        }

        <div id="plan-schedule-warnings" class="plan-alert-panel plan-alert-panel--schedule hidden" aria-live="polite">
          <p class="plan-alert-panel__title">Season offering alerts</p>
          <p id="plan-schedule-warnings-hint" class="plan-alert-panel__hint">
            Based on scraped York timetables (not year-specific).
          </p>
          <ul id="plan-schedule-warnings-list" class="plan-alert-panel__content"></ul>
        </div>
        </div>

        <p id="plan-editor-status" class="mb-3 text-xs text-york-muted" />

        {
          showSummerRow && (
            <p class="plan-summer-hint mb-3 text-xs text-york-muted">
              Summer is optional for each year. Use <strong>+ Add summer courses</strong> to create a summer term, then search the catalogue or drag courses from Fall or Winter.
            </p>
          )
        }

        <dialog id="plan-add-course-dialog" class="plan-add-course-dialog" aria-labelledby="plan-add-course-title">
          <form method="dialog" class="plan-add-course-form">
            <header class="plan-add-course-header">
              <div>
                <p class="plan-add-course-kicker" id="plan-add-course-kicker">Add to plan</p>
                <h2 id="plan-add-course-title" class="plan-add-course-title">Search courses</h2>
                <p id="plan-add-course-term" class="plan-add-course-term text-xs text-york-muted" />
              </div>
              <button type="button" class="plan-add-course-close" data-action="close-add-course" aria-label="Close">
                ×
              </button>
            </header>
            <input
              type="text"
              id="plan-add-course-search"
              class="plan-add-course-search"
              placeholder="Course code or title…"
              autocomplete="off"
              enterkeyhint="search"
            />
            <p id="plan-add-course-status" class="plan-add-course-status text-xs text-york-muted" />
            <ul id="plan-add-course-results" class="plan-add-course-results" />
            <p id="plan-add-course-error" class="plan-add-course-error hidden text-sm text-york-red" />
            <footer class="plan-add-course-footer">
              <button type="button" class="plan-add-course-cancel" data-action="close-add-course">Cancel</button>
            </footer>
          </form>
        </dialog>

        <div class="plan-editor-canvas" id="plan-editor-canvas">
          <div class="plan-editor-stage" id="plan-editor-stage">
            <svg id="plan-deps-svg" class="plan-deps-layer" aria-hidden="true" />
            <div
              class:list={["plan-year-board", showSummerRow && "plan-year-board--with-summer"]}
              id="plan-editor-columns"
              style={`--year-count: ${Math.max(yearColumns.length, 1)}`}
            >
              {
                yearColumns.map((year, yearIndex) => {
                  const seasons = seasonSlotsForYear(year, showSummerRow);
                  const yearCredits = plan
                    ? summarizeChecklistYear(plan.terms, year.checklistYear)
                    : null;

                  return (
                    <section
                      class="plan-year-column"
                      data-checklist-year={year.checklistYear}
                      style={`--year-index: ${yearIndex}`}
                    >
                      <header class="plan-year-header">
                        <p class="plan-year-kicker">Year {year.checklistYear}</p>
                        <h2 class="plan-year-title">{academicSpan(year.academicYear)}</h2>
                        {
                          yearCredits && (
                            <p
                              class="plan-year-credits"
                              data-checklist-year={year.checklistYear}
                            >
                              {formatYearCredits(yearCredits)}
                            </p>
                          )
                        }
                      </header>

                      {
                        seasons.map(({ key, term, label }) => {
                          if (!term) {
                            const isSummer = key === "summer";
                            return (
                              <div
                                class:list={[
                                  "plan-term-bubble plan-term-bubble--empty",
                                  `plan-term-bubble--${key}`,
                                ]}
                                data-season={key}
                                data-checklist-year={year.checklistYear}
                              >
                                <div class="plan-term-header">
                                  <p class="plan-term-session">{label}</p>
                                  <p class="plan-term-meta">
                                    {isSummer ? "Optional" : "No courses scheduled"}
                                  </p>
                                </div>
                                {
                                  isSummer ? (
                                    <>
                                      <ul
                                        class="plan-course-list"
                                        data-checklist-year={year.checklistYear}
                                        data-drop-zone
                                      >
                                        <li class="plan-course-empty">
                                          Drop courses here — we will create a summer term
                                        </li>
                                      </ul>
                                      <button
                                        type="button"
                                        class="plan-term-add-summer"
                                        data-checklist-year={year.checklistYear}
                                      >
                                        + Add summer courses
                                      </button>
                                    </>
                                  ) : (
                                    <div class="plan-term-empty-body">
                                      <p>Add a {label.toLowerCase()} term to place courses here.</p>
                                    </div>
                                  )
                                }
                              </div>
                            );
                          }

                          const termSummary = summarizeTerm(term);
                          const count = termSummary.courseCount;
                          const hasComplementaryStub = term.courses.some((course) =>
                            isComplementaryStub(course),
                          );

                          return (
                            <div
                              class:list={["plan-term-bubble", `plan-term-bubble--${key}`]}
                              data-term-id={term.id}
                              data-season={key}
                              data-complementary-term={hasComplementaryStub ? "true" : undefined}
                            >
                              <div class="plan-term-header">
                                <p class="plan-term-session">{label}</p>
                                <h3 class="plan-term-title">{term.label}</h3>
                                <span
                                  class="plan-term-schedule-warn"
                                  hidden
                                  aria-label="Season offering warnings in this term"
                                ></span>
                              </div>

                              <ul class="plan-course-list" data-term-id={term.id} data-drop-zone>
                                {
                                  term.courses.length > 0 ? (
                                    term.courses.map((course: PlanCourse) => {
                                      const isStub = course.entry_kind === "stub";
                                      const isComplementaryPlacement =
                                        course.section_label === "Complementary Studies";
                                      const isComplementaryStubCard = isComplementaryStub(course);
                                      const stubDisplay = isComplementaryStubCard
                                        ? formatComplementaryStubDisplay(course)
                                        : null;
                                      const displayLabel = isStub
                                        ? (stubDisplay?.header ??
                                          course.section_label ??
                                          course.title ??
                                          course.course_code)
                                        : course.course_code;
                                      const dragLabel = isStub
                                        ? formatStubDragLabel(course)
                                        : course.course_code;
                                      return (
                                        <li
                                          class:list={["plan-course-card", { "plan-course-card--stub": isStub }]}
                                          data-course-id={course.id}
                                          data-course-code={course.course_code}
                                          data-entry-kind={course.entry_kind ?? "course"}
                                          {...(isComplementaryPlacement || isComplementaryStubCard
                                            ? { "data-section-label": course.section_label ?? "Complementary Studies" }
                                            : {})}
                                          {...(isComplementaryStubCard ? { "data-complementary-stub": "true" } : {})}
                                        >
                                          {
                                            !isStub && (
                                              <>
                                                <label class="plan-course-complete-wrap" title="Mark as completed">
                                                  <input
                                                    type="checkbox"
                                                    class="plan-course-complete"
                                                    checked={course.completed ?? false}
                                                    aria-label={`Mark ${course.course_code} as completed`}
                                                  />
                                                </label>
                                                {
                                                  isComplementaryPlacement && (
                                                    <button
                                                      type="button"
                                                      class="plan-course-remove"
                                                      title={`Remove ${course.course_code} from plan`}
                                                      aria-label={`Remove ${course.course_code} from plan`}
                                                    >
                                                      ×
                                                    </button>
                                                  )
                                                }
                                              </>
                                            )
                                          }
                                          <span class="plan-course-warning" hidden aria-label="Unmet prerequisites">!</span>
                                          <span
                                            class="plan-course-schedule-warn"
                                            hidden
                                            aria-label="Season offering warning"
                                          >S</span>
                                          <span
                                            class="plan-course-handle"
                                            role="button"
                                            tabindex="0"
                                            draggable={
                                              !isStub || isComplementaryStubDraggable(course)
                                                ? "true"
                                                : undefined
                                            }
                                            aria-label={`Drag ${dragLabel} to another term or trash`}
                                          >
                                            ⋮⋮
                                          </span>
                                          <div class="plan-course-body">
                                            {
                                              isStub ? (
                                                <Fragment>
                                                  <p class="plan-course-code">{displayLabel}</p>
                                                  {
                                                    isComplementaryStubCard ? (
                                                      <p class="plan-stub-options text-xs text-york-muted">
                                                        {stubDisplay?.subtitle}
                                                      </p>
                                                    ) : (
                                                      <>
                                                        {
                                                          course.title && course.title !== displayLabel && (
                                                            <p class="plan-stub-options">{course.title}</p>
                                                          )
                                                        }
                                                        {
                                                          !course.title && (
                                                            <p class="text-xs text-york-muted">
                                                              Pick from checklist options
                                                            </p>
                                                          )
                                                        }
                                                      </>
                                                    )
                                                  }
                                                </Fragment>
                                              ) : (
                                                <p class="plan-course-code">{course.course_code}</p>
                                              )
                                            }
                                            {
                                              course.title && !isStub && (
                                                <p class="text-xs text-york-muted">{course.title}</p>
                                              )
                                            }
                                            {
                                              course.credits != null && (
                                                <span class="plan-course-credits">{course.credits} cr</span>
                                              )
                                            }
                                          </div>
                                        </li>
                                      );
                                    })
                                  ) : (
                                    <li class="plan-course-empty">Drop courses here</li>
                                  )
                                }
                              </ul>

                              <button
                                type="button"
                                class="plan-term-add-course"
                                data-term-id={term.id}
                                data-term-label={term.label}
                              >
                                + Add course
                              </button>

                              <div class="plan-term-footer">
                                <span class="plan-term-count" data-term-id={term.id}>
                                  {count} course{count === 1 ? "" : "s"}
                                </span>
                                <span class="plan-term-credits" data-term-id={term.id}>
                                  {formatTermCredits(termSummary)}
                                </span>
                              </div>
                            </div>
                          );
                        })
                      }
                    </section>
                  );
                })
              }
            </div>
          </div>
        </div>

        <div id="plan-trash-zone" class="plan-trash-zone" hidden aria-hidden="true">
          <div class="plan-trash-zone__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7h16" />
              <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
              <path d="M7 7l1 13a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-13" />
              <path d="M10 11v5" />
              <path d="M14 11v5" />
            </svg>
          </div>
          <p class="plan-trash-zone__label">Drop to remove</p>
        </div>

        <p class="mt-4 text-xs text-york-muted">
          Click a course to show prerequisite (blue) and co-requisite (amber dashed) links · click elsewhere to hide · tick courses you have already completed · drag a course to the trash to remove it · an <strong>S</strong> badge means scraped timetable history has no offerings in that Fall/Winter/Summer slot.
        </p>
      </div>
    )
  }

  {
    plan && (
      <script>
        import "../../scripts/plan-editor.ts";
      </script>
    )
  }
</DashboardLayout>
