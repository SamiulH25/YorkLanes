---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import "../../styles/schedule-page.css";
import "../../styles/schedule-shuffle.css";

export const prerender = false;

const focusCourse = Astro.url.searchParams.get("course")?.trim().toUpperCase() ?? "";
const focusTerm = Astro.url.searchParams.get("term")?.trim() ?? "";
const initialView = Astro.url.searchParams.get("view") === "timetable" ? "timetable" : "build";
const startNew = Astro.url.searchParams.get("new") === "1";
---

<DashboardLayout title="Schedule | YorkLanes" activeNav="schedule">
  <Fragment slot="header">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="label">This term</p>
        <h1 class="heading-page" data-schedule-page-title>Weekly timetable</h1>
        <p class="mt-1 text-sm text-muted" data-schedule-page-subtitle>
          Open a saved timetable or create one for a plan year and semester.
        </p>
      </div>
      <a href="/plan" class="btn-ghost shrink-0 px-4 py-2 text-sm">Open degree plan</a>
    </div>
  </Fragment>

  <div
    class="schedule-layout"
    data-schedule-root
    data-focus-course={focusCourse}
    data-focus-term={focusTerm}
    data-initial-view={initialView}
    data-start-new={startNew ? "true" : "false"}
    data-schedule-mode="home"
    style={`--schedule-day-count: 5; --schedule-row-height: 5rem;`}
  >
    <section class="surface p-5 schedule-home" data-schedule-home>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="label">Your timetables</p>
          <h2 class="heading-widget mt-1">Saved schedules</h2>
          <p class="mt-1 text-sm text-muted">Pick a schedule to view or edit, or start a new one.</p>
          <p class="mt-2 text-xs text-muted">
            Your <strong>dashboard</strong> shows today&apos;s classes from whichever schedule you mark as your dashboard schedule.
          </p>
        </div>
        <button type="button" class="btn-york px-4 py-2 text-sm" data-schedule-new>
          New schedule
        </button>
      </div>
      <div class="schedule-saved-list mt-5" data-schedule-saved>
        <p class="schedule-status">Loading saved schedules…</p>
      </div>
      <p class="schedule-dashboard-hint mt-3 text-xs text-muted hidden" data-schedule-dashboard-hint hidden>
        Choose a dashboard schedule so the home page can show today&apos;s classes.
      </p>
    </section>

    <section class="surface p-5 schedule-create" data-schedule-create hidden>
      <button type="button" class="schedule-back-link" data-schedule-back-home>
        ← All schedules
      </button>
      <p class="label mt-4">New schedule</p>
      <h2 class="heading-widget mt-1">Choose year &amp; semester</h2>
      <p class="mt-1 text-sm text-muted">
        Select your plan year, semester, and scraped CDM term. Courses load from your degree plan.
      </p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="label">Plan year</span>
          <select data-schedule-year class="field-select mt-2" aria-label="Select plan year">
            <option value="1">Year 1</option>
          </select>
        </label>

        <label class="block">
          <span class="label">Semester</span>
          <select data-schedule-season class="field-select mt-2" aria-label="Select semester">
            <option value="all">Full year</option>
            <option value="fall">Fall</option>
            <option value="winter">Winter</option>
            <option value="summer">Summer</option>
          </select>
        </label>

        <label class="block sm:col-span-2">
          <span class="label">CDM term</span>
          <p class="mt-0.5 text-xs text-muted">Scraped timetable term (e.g. 2026-2027 FW)</p>
          <select data-schedule-term class="field-select mt-2" aria-label="Select academic term">
            <option value="">Loading terms…</option>
          </select>
        </label>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-york px-4 py-2 text-sm" data-schedule-confirm disabled>
          Start building
        </button>
        <p class="schedule-status" data-schedule-setup-hint>Select a CDM term to continue.</p>
      </div>
    </section>

    <div class="schedule-editor" data-schedule-editor hidden>
      <div class="surface flex flex-wrap items-center justify-between gap-3 p-4" data-schedule-context-bar>
        <div class="min-w-0">
          <p class="label">Current schedule</p>
          <p class="text-sm font-semibold text-foreground" data-schedule-context-label>Year 1 · Full year</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" class="btn-ghost px-3 py-2 text-xs" data-schedule-panel-toggle aria-expanded="true">
            Hide section choices
          </button>
          <button
            type="button"
            class="schedule-dashboard-btn btn-york px-3 py-2 text-xs"
            data-schedule-set-active
            title="Use this timetable for today's classes on your dashboard"
          >
            Use on dashboard
          </button>
          <button type="button" class="btn-ghost px-3 py-2 text-xs" data-schedule-back-home>
            All schedules
          </button>
          <button type="button" class="btn-ghost px-3 py-2 text-xs" data-schedule-new>
            New schedule
          </button>
        </div>
      </div>

      <div class="schedule-editor-workspace" data-schedule-workspace-layout data-panel-collapsed="false">
        <aside class="schedule-side-panel" data-schedule-side-panel aria-hidden="false">
          <section class="surface p-5">
            <div>
              <p class="label">Year courses</p>
              <h2 class="heading-widget mt-1">From your degree plan</h2>
            </div>
            <div class="schedule-course-list mt-4" data-schedule-courses></div>

            <form data-schedule-search class="mt-5 grid gap-3">
              <label class="block">
                <span class="label">Search course</span>
                <input
                  name="courseCode"
                  type="text"
                  placeholder="EECS 1028"
                  class="field-input"
                />
              </label>
              <button type="submit" class="btn-york w-full justify-center text-sm">Load sections</button>
            </form>
          </section>

          <section class="surface p-5">
            <div>
              <p class="label">Weekly section set</p>
              <h2 class="heading-widget mt-1" data-schedule-section-heading>Section choices</h2>
            </div>
            <div class="schedule-section-browser mt-4" data-schedule-sections>
              <p class="schedule-status">Select a course to browse scraped section times.</p>
            </div>
          </section>
        </aside>

        <div class="schedule-main-panel">
          <p data-schedule-status class="schedule-status" role="status" aria-live="polite" hidden></p>

          <section class="schedule-grid-shell">
            <div class="schedule-grid-toolbar">
              <div>
                <p class="label">Weekly timetable</p>
                <p class="text-sm text-muted" data-schedule-timetable-subtitle>
                  All courses from your degree plan are included. Use ← → to cycle conflict-free timetables (labs and tutorials change; pin a course to lock it).
                </p>
              </div>
              <div class="schedule-grid-toolbar__actions">
                <div class="schedule-shuffle-nav" data-schedule-shuffle-nav>
                  <button
                    type="button"
                    class="schedule-shuffle-nav__btn"
                    data-schedule-shuffle-prev
                    title="Previous timetable"
                    aria-label="Previous timetable"
                  >
                    ←
                  </button>
                  <span class="schedule-shuffle-meta text-xs text-muted" data-schedule-shuffle-meta hidden></span>
                  <button
                    type="button"
                    class="schedule-shuffle-nav__btn"
                    data-schedule-shuffle-next
                    title="Next timetable"
                    aria-label="Next timetable"
                  >
                    →
                  </button>
                </div>
              </div>
            </div>
            <div class="schedule-grid-empty hidden" data-schedule-grid-empty hidden>
              <p class="schedule-status">No classes on this timetable yet.</p>
              <p class="mt-2 text-sm text-muted">
                Courses from your degree plan load here automatically when section data is available.
              </p>
            </div>
            <div class="schedule-grid" data-schedule-grid>
              <div class="schedule-grid__header" data-schedule-grid-header>
                <div class="schedule-grid__corner"></div>
                <div class="schedule-grid__day">Monday</div>
                <div class="schedule-grid__day">Tuesday</div>
                <div class="schedule-grid__day">Wednesday</div>
                <div class="schedule-grid__day">Thursday</div>
                <div class="schedule-grid__day">Friday</div>
              </div>

              <div class="relative" style={`--schedule-row-height: 5rem;`}>
                <div data-schedule-grid-body>
                  {
                    Array.from({ length: 12 }).map((_, index) => {
                      const hour = 8 + index;
                      const period = hour >= 12 ? "PM" : "AM";
                      const displayHour = hour % 12 || 12;
                      return (
                        <div class="schedule-grid__row">
                          <div class="schedule-grid__hour">{displayHour}:00 {period}</div>
                          <div class="schedule-grid__cell"></div>
                          <div class="schedule-grid__cell"></div>
                          <div class="schedule-grid__cell"></div>
                          <div class="schedule-grid__cell"></div>
                          <div class="schedule-grid__cell"></div>
                        </div>
                      );
                    })
                  }
                </div>
                <div class="schedule-grid__events" data-schedule-events></div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../../scripts/schedule-page.ts";
  </script>
</DashboardLayout>
