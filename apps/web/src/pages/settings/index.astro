---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { themes } from "../../lib/themes";
import { fetchSessionUser, signOutUrl } from "../../lib/auth";

export const prerender = false;

const cookie = Astro.request.headers.get("cookie");
const sessionUser = await fetchSessionUser(cookie);
const displayName = sessionUser?.displayName ?? "Guest";
const signedIn = Boolean(sessionUser);
const logoutUrl = signOutUrl();

const swatches: Record<string, string> = Object.fromEntries(themes.map((theme) => [theme.id, theme.swatch]));
---

<DashboardLayout title="Settings | YorkLanes">
  <Fragment slot="header">
    <div>
      <p class="text-xs font-medium text-york-muted">Preferences</p>
      <h1 class="heading-page">Settings</h1>
      <p class="mt-0.5 text-sm text-muted">Customize appearance and manage your account.</p>
    </div>
  </Fragment>

  <div class="grid gap-5 lg:grid-cols-2">
    <section class="surface p-5">
      <h2 class="heading-widget">Color theme</h2>
      <p class="mt-1 text-sm text-muted">Pick an accent color for buttons, links, and highlights.</p>
      <div class="mt-4 flex flex-wrap gap-2" role="list">
        {
          themes.map((theme) => (
            <button
              type="button"
              data-theme-id={theme.id}
              class="settings-theme-option flex items-center gap-2 rounded-xl border border-york-stone/60 px-3 py-2 text-sm transition hover:border-york-red/40 dark:border-white/10"
              aria-label={theme.label}
              title={theme.label}
            >
              <span
                class="theme-swatch h-5 w-5 rounded-full border border-black/10"
                style={`background: ${swatches[theme.id]}`}
                aria-hidden="true"
              />
              <span>{theme.label}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="surface p-5">
      <h2 class="heading-widget">Appearance</h2>
      <p class="mt-1 text-sm text-muted">Switch between light and dark mode.</p>
      <div class="mode-toggle mt-4 inline-flex rounded-xl border border-york-stone/60 p-1 dark:border-white/10" role="group" aria-label="Color mode">
        <button type="button" data-mode-pick="light" class="mode-pick rounded-lg px-4 py-2 text-sm font-medium">
          Light
        </button>
        <button type="button" data-mode-pick="dark" class="mode-pick rounded-lg px-4 py-2 text-sm font-medium">
          Dark
        </button>
      </div>
    </section>

    <section class="surface p-5 lg:col-span-2">
      <h2 class="heading-widget">Account</h2>
      <p class="mt-1 text-sm text-muted">
        {signedIn ? `Signed in as ${displayName}.` : "Sign in to sync your degree plan and assignments."}
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        {
          signedIn ? (
            <a href={logoutUrl} data-astro-reload class="btn-york px-4 py-2 text-sm">
              Sign out
            </a>
          ) : (
            <a href="/login" class="btn-york px-4 py-2 text-sm">Sign in</a>
          )
        }
        <a href="/onboarding" class="btn-ghost px-4 py-2 text-sm">Setup wizard</a>
      </div>
    </section>
  </div>
</DashboardLayout>

<style>
  :global(.settings-theme-option.is-active) {
    border-color: color-mix(in srgb, var(--theme-primary) 35%, transparent);
    background: color-mix(in srgb, var(--theme-primary) 8%, transparent);
  }

  :global(.settings-theme-option.is-active .theme-swatch) {
    border-color: var(--theme-primary);
    box-shadow: var(--theme-shadow-button);
  }

  :global(html:not(.dark) .mode-pick[data-mode-pick="light"]),
  :global(html:not(.dark) .mode-pick.is-active[data-mode-pick="light"]) {
    background: var(--theme-primary);
    color: var(--theme-on-primary);
  }

  :global(html.dark .mode-pick[data-mode-pick="dark"]),
  :global(html.dark .mode-pick.is-active[data-mode-pick="dark"]) {
    background: var(--theme-primary);
    color: var(--theme-on-primary);
  }
</style>
